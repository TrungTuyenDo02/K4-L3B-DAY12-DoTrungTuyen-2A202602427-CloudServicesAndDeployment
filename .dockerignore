# File này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secret — tuyệt đối không vào image
.env
.env.*

# Git & CI
.git
.gitignore
.github

# Môi trường ảo & cache Python
.venv
venv
__pycache__
*.pyc
.pytest_cache

# Không cần lúc chạy
tests
screenshots
*.md
.claude-notes
.kilo
